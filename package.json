{
  "name": "mcp-gmail-multi-account",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Remote MCP server for Gmail with support for multiple connected accounts, deployed on Cloudflare Workers, for use as a claude.ai custom connector",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boonkgim/mcp-gmail-multi-account.git"
  },
  "bugs": "https://github.com/boonkgim/mcp-gmail-multi-account/issues",
  "homepage": "https://github.com/boonkgim/mcp-gmail-multi-account#readme",
  "scripts": {
    "deploy": "wrangler deploy --env=\"\"",
    "dev": "wrangler dev --env development",
    "start": "wrangler dev --env development",
    "cf-typegen": "wrangler types",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run type-check && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.10.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "agents": "^0.20.1",
    "hono": "^4.13.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.105.0"
  }
}
